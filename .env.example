# Copy to .env and fill in. NEVER commit the real .env file.
#
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs session cookies and CSRF tokens (>= 32 characters). Changing it logs everyone out.
SECRET_KEY=

# Server-side secret mixed into every user's vault key (>= 32 characters).
# LOSING OR CHANGING THIS MAKES ALL STORED PASSWORDS UNREADABLE - back it up separately from the database.
ENCRYPTION_PEPPER=

# --- Optional -----------------------------------------------------------------
# DATABASE_PATH=instance/vault.db
# LOG_DIR=logs
# SESSION_IDLE_MINUTES=15
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_MINUTES=15

# Set to true when serving over HTTPS (recommended for anything but localhost).
# SESSION_COOKIE_SECURE=true

# Set to true ONLY behind a reverse proxy you control (trusts X-Forwarded-* headers).
# TRUST_PROXY=false
